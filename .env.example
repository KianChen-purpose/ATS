# --- Database ---
DATABASE_URL=postgres://pats:pats@localhost:5432/pats
# Optional: read replica / warehouse for reports, exports and the Power BI feed
# (ARCHITECTURE.md D10). Blank = the primary, through a read-only, time-limited connection.
REPORTING_DATABASE_URL=

# --- Session ---
# Required, at least 32 characters. Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In Azure this comes from Key Vault. The app refuses to start without it.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Demo sign-in ---
# "Sign in as any user" for local demos. Only honoured outside production;
# the app refuses to start if this is true in production.
PATS_DEMO_AUTH=true

# --- Microsoft 365 (optional) ---
# Leave blank to run every M365 integration in mock mode.
# Fill in from an Entra ID app registration to go live (see docs/INTEGRATIONS.md).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Mailbox used for app-sent candidate email (e.g. careers@purpose.ca)
M365_SENDER_MAILBOX=

# --- File storage ---
# Local folder for the dev FileStore (offer letters, templates). In Azure this is
# Azure Blob Storage / SharePoint in Canada Central, configured on the FileStore port.
FILE_STORE_DIR=.storage
