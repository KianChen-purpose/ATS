# --- Database ---
DATABASE_URL=postgres://pats:pats@localhost:5432/pats

# --- Session ---
# Any long random string. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Microsoft 365 (optional) ---
# Leave blank to run every M365 integration in mock mode.
# Fill in from an Entra ID app registration to go live (see docs/INTEGRATIONS.md).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Mailbox used for app-sent candidate email (e.g. careers@purpose.ca)
M365_SENDER_MAILBOX=
